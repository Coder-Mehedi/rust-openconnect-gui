# Maintainer: Mehedi Hasan <mehedi5051@gmail.com>
pkgname=rust-openconnect-gui
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal Rust/egui GUI for openconnect VPN: keyring password storage, unattended connects"
arch=('x86_64')
url="https://github.com/Coder-Mehedi/rust-openconnect-gui"
license=('MIT')
depends=('openconnect' 'sudo' 'procps-ng' 'gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'hicolor-icon-theme')
makedepends=('cargo')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('55a48b029d26beacbc1e89bf857d5b70a6c4fe34e5f8878f0c7814c3ef34b527')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --frozen
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/rust-openconnect-gui -t "$pkgdir/usr/bin"
    install -Dm644 assets/rust-openconnect-gui.desktop -t "$pkgdir/usr/share/applications"
    install -Dm644 assets/rust-openconnect-gui.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
